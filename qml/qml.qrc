<RCC>
    <!-- React (Ionic build) -->
    <qresource prefix="/web">
        <file alias="index.html">../web/index.html</file>
        <file alias="app.js">../web/app.js</file>
        <file alias="app.css">../web/app.css</file>
        <file alias="manifest.json">../web/manifest.json</file>
        <file alias="favicon.png">../web/favicon.png</file>
        <file alias="wasm/zxing_reader.wasm">../web/wasm/zxing_reader.wasm</file>
        <file alias="fonts/satoshi/Satoshi-Variable.woff2">../web/fonts/satoshi/Satoshi-Variable.woff2</file>
        <file alias="fonts/satoshi/Satoshi-Regular.woff2">../web/fonts/satoshi/Satoshi-Regular.woff2</file>
        <file alias="fonts/satoshi/Satoshi-Medium.woff2">../web/fonts/satoshi/Satoshi-Medium.woff2</file>
        <file alias="fonts/satoshi/Satoshi-Bold.woff2">../web/fonts/satoshi/Satoshi-Bold.woff2</file>
        <file alias="fonts/satoshi/Satoshi-Black.woff2">../web/fonts/satoshi/Satoshi-Black.woff2</file>
    </qresource>

    <!-- QML -->
    <qresource prefix="/qml">
        <file>Main.qml</file>
    </qresource>
</RCC>